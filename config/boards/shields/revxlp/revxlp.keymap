            bindings = <
&none      &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &kp LC(LS(OP_QUOT)) &kp C_PREV         &kp C_PP       &kp C_NEXT         &trans         &none
&bl BL_TOG &none        &none        &none        &none        &none                        &kp LC(LS(S))       &kp LG(LC(LS(N4))) &kp LG(LS(N4)) &kp LG(LC(LS(N3))) &kp LG(LS(N3)) &bl BL_CYCLE
&none      &none        &none        &none        &none        &trans                       &kp LG(LS(OP_M))    &kp LG(LS(N9))     &kp RG(RS(UP)) &kp RG(RS(DOWN))   &kp LG(LS(N0)) &none
                                     &bt BT_CLR   &none        &none                        &kp SPACE           &kp LG(OP_COMM)    &kp LG(OP_DOT)
            >;
